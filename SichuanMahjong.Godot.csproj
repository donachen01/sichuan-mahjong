<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ExportRelease'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="scripts/ai/SichuanCSharpRuntime.cs" />
    <Compile Include="scripts/ai/SichuanDecisionAuditRuntime.cs" />
    <ProjectReference Include="dotnet/AI.Core/AI.Core.csproj" />
  </ItemGroup>
  <Target Name="ValidateStrategyRelease" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ExportRelease'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/tools/validate_strategy_release.py&quot;" />
  </Target>
</Project>
