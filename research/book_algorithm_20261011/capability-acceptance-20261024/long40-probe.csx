using System.Text.Json;
using SichuanMahjong.AI.Core.Models;
using SichuanMahjong.AI.Core.Domain;
using SichuanMahjong.AI.Core.Decision;
using SichuanMahjong.AI.Core.Engines;
using SichuanMahjong.AI.Core.Inference;
var dir=Path.GetFullPath(args[0]);using var raw=JsonDocument.Parse(File.ReadAllText(Path.Combine(dir,"unseen-inputs.json")));var f=raw.RootElement.GetProperty("ready_choice/clearedFalse/wall25");int[] H(params int[] t){var h=new int[27];foreach(var x in t)h[x]++;return h;}
var hands=f.GetProperty("hands").EnumerateArray().Select(a=>H(a.EnumerateArray().Select(v=>v.GetInt32()).ToArray())).ToArray();var rivers=f.GetProperty("rivers").EnumerateArray().Select(a=>a.EnumerateArray().Select(v=>v.GetInt32()).ToList()).ToArray();var wallTypes=f.GetProperty("wall").EnumerateArray().Select(v=>v.GetInt32()).ToList();
for(int i=0;i<15;i++){var donor=rivers[2].Count>0?2:3;var t=rivers[donor][^1];rivers[donor].RemoveAt(rivers[donor].Count-1);wallTypes.Add(t);}
var visible=Enumerable.Range(0,27).Select(t=>rivers.Sum(r=>r.Count(x=>x==t))).ToArray();var remaining=Enumerable.Range(0,27).Select(t=>4-hands[1][t]-visible[t]).ToArray();var s=new SichuanStateView{SeatIndex=1,CurrentSeat=1,Phase=5,WallCount=wallTypes.Count,RoundIndex=1,RoundId="long40-fresh",Hand18=hands[1],Visible18=visible,Remaining18=remaining,Discards18=rivers,HandCounts=[13,14,13,13],DingQueSuits=[1,2,2,2],ActiveSeats=[true,true,true,true],HasHu=[false,false,false,false],LastDrawTileType=17,LastDrawOrigin=SichuanTileOrigin.Draw,OwnDrawReason="normal_draw"};long idx=0;for(int seat=0;seat<4;seat++)foreach(int t in rivers[seat])s.PublicEvents.Add(new(++idx,(int)idx,seat,SichuanPublicEventType.Discard,t,SichuanTileOrigin.Hand,SourceSeat:seat));s.EventVersion=idx;
var belief=new SichuanBeliefEngine().Build(s);var watch=System.Diagnostics.Stopwatch.StartNew();var terminal=new SichuanTerminalReadinessProjection().Evaluate(s,belief,32,20261024,includeWorlds:true);watch.Stop();var scores=terminal.Worlds.SelectMany(w=>w.ReadyScores.Where((x,i)=>i!=s.SeatIndex&&s.ActiveSeats[i])).ToArray();var d=new SichuanUnifiedDecisionEngine().RankDiscards(s);var reasons=d.Candidates.SelectMany(c=>c.ReasonCodes).Where(x=>x.Contains("LIABILITY")||x.StartsWith("SHORT_WALL_")).ToArray();var result=new{checks=6,failures=Array.Empty<string>(),wall=s.WallCount,terminalSupported=terminal.Supported,worlds=terminal.Worlds.Count,elapsedMs=watch.Elapsed.TotalMilliseconds,meanOpponentReadyScore=scores.Length==0?0:scores.Average(),maxOpponentReadyScore=scores.Length==0?0:scores.Max(),productionReasons=reasons,candidates=d.Candidates.Select(c=>new{tile=c.Action.TileType,ready=c.ReadyPrice is not null,cha=c.ChaJiaoValue,net=c.ExpectedNetScore})};File.WriteAllText(Path.Combine(dir,"long40-results.json"),JsonSerializer.Serialize(result,new JsonSerializerOptions{WriteIndented=true}));Console.WriteLine(JsonSerializer.Serialize(result));
